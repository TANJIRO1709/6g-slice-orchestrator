frontend/.next/
frontend/out/

# Local scratch
backend/*.bak
backend/results.txt
backend/startup.log
.git/
.DS_Store

# Local-only Next.js env (e.g. pointing the dashboard at Render)
.env*.local
frontend/.env*.local
